{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "13079533665505481280"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Application name prefix for resources"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for regional resources (Cosmos DB, Key Vault)"
      }
    },
    "repositoryUrl": {
      "type": "string",
      "metadata": {
        "description": "GitHub repository URL (https://github.com/ORG/REPO)"
      }
    },
    "repositoryToken": {
      "type": "securestring",
      "metadata": {
        "description": "GitHub personal access token with repo scope"
      }
    },
    "adminKey": {
      "type": "securestring",
      "metadata": {
        "description": "Admin key for POST /api/results"
      }
    }
  },
  "variables": {
    "cosmosAccountName": "[toLower(replace(format('{0}-cosmos', parameters('appName')), '-', ''))]",
    "keyVaultName": "[take(format('{0}kv{1}', replace(parameters('appName'), '-', ''), uniqueString(resourceGroup().id)), 24)]",
    "staticWebAppLocation": "eastus2"
  },
  "resources": {
    "cosmos": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "cosmosDeploy",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "accountName": {
            "value": "[variables('cosmosAccountName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "languageVersion": "2.0",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.39.26.7824",
              "templateHash": "7183895962576668459"
            }
          },
          "parameters": {
            "accountName": {
              "type": "string",
              "metadata": {
                "description": "Cosmos DB account name (lowercase, globally unique)"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for Cosmos DB"
              }
            }
          },
          "variables": {
            "databaseName": "worldcup-predictor"
          },
          "resources": {
            "cosmosAccount": {
              "type": "Microsoft.DocumentDB/databaseAccounts",
              "apiVersion": "2023-11-15",
              "name": "[parameters('accountName')]",
              "location": "[parameters('location')]",
              "kind": "GlobalDocumentDB",
              "properties": {
                "databaseAccountOfferType": "Standard",
                "locations": [
                  {
                    "locationName": "[parameters('location')]",
                    "failoverPriority": 0,
                    "isZoneRedundant": false
                  }
                ],
                "capabilities": [
                  {
                    "name": "EnableServerless"
                  }
                ]
              }
            },
            "database": {
              "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
              "apiVersion": "2023-11-15",
              "name": "[format('{0}/{1}', parameters('accountName'), variables('databaseName'))]",
              "properties": {
                "resource": {
                  "id": "[variables('databaseName')]"
                }
              },
              "dependsOn": [
                "cosmosAccount"
              ]
            },
            "predictionsContainer": {
              "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
              "apiVersion": "2023-11-15",
              "name": "[format('{0}/{1}/{2}', parameters('accountName'), variables('databaseName'), 'predictions')]",
              "properties": {
                "resource": {
                  "id": "predictions",
                  "partitionKey": {
                    "paths": [
                      "/email"
                    ],
                    "kind": "Hash"
                  }
                }
              },
              "dependsOn": [
                "database"
              ]
            },
            "resultsContainer": {
              "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
              "apiVersion": "2023-11-15",
              "name": "[format('{0}/{1}/{2}', parameters('accountName'), variables('databaseName'), 'results')]",
              "properties": {
                "resource": {
                  "id": "results",
                  "partitionKey": {
                    "paths": [
                      "/id"
                    ],
                    "kind": "Hash"
                  }
                }
              },
              "dependsOn": [
                "database"
              ]
            }
          },
          "outputs": {
            "connectionString": {
              "type": "securestring",
              "value": "[listConnectionStrings('cosmosAccount', '2023-11-15').connectionStrings[0].connectionString]"
            },
            "endpoint": {
              "type": "string",
              "value": "[reference('cosmosAccount').documentEndpoint]"
            },
            "databaseName": {
              "type": "string",
              "value": "[variables('databaseName')]"
            }
          }
        }
      }
    },
    "keyVault": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "keyVaultDeploy",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "vaultName": {
            "value": "[variables('keyVaultName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "cosmosConnectionString": {
            "value": "[listOutputsWithSecureValues('cosmos', '2025-04-01').connectionString]"
          },
          "adminKey": {
            "value": "[parameters('adminKey')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.39.26.7824",
              "templateHash": "2576915980376348766"
            }
          },
          "parameters": {
            "vaultName": {
              "type": "string",
              "metadata": {
                "description": "Key Vault name (globally unique, 3-24 characters)"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for Key Vault"
              }
            },
            "cosmosConnectionString": {
              "type": "securestring",
              "metadata": {
                "description": "Cosmos DB connection string to store as a secret"
              }
            },
            "adminKey": {
              "type": "securestring",
              "metadata": {
                "description": "Admin key for the API results endpoint"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults",
              "apiVersion": "2023-07-01",
              "name": "[parameters('vaultName')]",
              "location": "[parameters('location')]",
              "properties": {
                "tenantId": "[subscription().tenantId]",
                "sku": {
                  "family": "A",
                  "name": "standard"
                },
                "enableRbacAuthorization": true,
                "enabledForTemplateDeployment": true,
                "enableSoftDelete": true,
                "softDeleteRetentionInDays": 7
              }
            },
            {
              "type": "Microsoft.KeyVault/vaults/secrets",
              "apiVersion": "2023-07-01",
              "name": "[format('{0}/{1}', parameters('vaultName'), 'CosmosConnectionString')]",
              "properties": {
                "value": "[parameters('cosmosConnectionString')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', parameters('vaultName'))]"
              ]
            },
            {
              "type": "Microsoft.KeyVault/vaults/secrets",
              "apiVersion": "2023-07-01",
              "name": "[format('{0}/{1}', parameters('vaultName'), 'AdminKey')]",
              "properties": {
                "value": "[parameters('adminKey')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', parameters('vaultName'))]"
              ]
            }
          ],
          "outputs": {
            "vaultName": {
              "type": "string",
              "value": "[parameters('vaultName')]"
            },
            "vaultUri": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('vaultName')), '2023-07-01').vaultUri]"
            },
            "cosmosSecretUri": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults/secrets', parameters('vaultName'), 'CosmosConnectionString'), '2023-07-01').secretUri]"
            },
            "adminSecretUri": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults/secrets', parameters('vaultName'), 'AdminKey'), '2023-07-01').secretUri]"
            }
          }
        }
      },
      "dependsOn": [
        "cosmos"
      ]
    },
    "staticWebApp": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "staticWebAppDeploy",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[parameters('appName')]"
          },
          "location": {
            "value": "[variables('staticWebAppLocation')]"
          },
          "repositoryUrl": {
            "value": "[parameters('repositoryUrl')]"
          },
          "repositoryToken": {
            "value": "[parameters('repositoryToken')]"
          },
          "cosmosDbName": {
            "value": "[reference('cosmos').outputs.databaseName.value]"
          },
          "cosmosSecretUri": {
            "value": "[reference('keyVault').outputs.cosmosSecretUri.value]"
          },
          "adminSecretUri": {
            "value": "[reference('keyVault').outputs.adminSecretUri.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.39.26.7824",
              "templateHash": "14647824278958101569"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Static Web App name"
              }
            },
            "location": {
              "type": "string",
              "defaultValue": "eastus2",
              "metadata": {
                "description": "Static Web Apps region (eastus2 supports Free tier)"
              }
            },
            "repositoryUrl": {
              "type": "string",
              "metadata": {
                "description": "GitHub repository URL"
              }
            },
            "repositoryToken": {
              "type": "securestring",
              "metadata": {
                "description": "GitHub personal access token with repo scope"
              }
            },
            "cosmosDbName": {
              "type": "string",
              "metadata": {
                "description": "Cosmos DB database name"
              }
            },
            "cosmosSecretUri": {
              "type": "string",
              "metadata": {
                "description": "Key Vault secret URI for CosmosConnectionString"
              }
            },
            "adminSecretUri": {
              "type": "string",
              "metadata": {
                "description": "Key Vault secret URI for AdminKey"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/staticSites",
              "apiVersion": "2023-12-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Free",
                "tier": "Free"
              },
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "repositoryUrl": "[parameters('repositoryUrl')]",
                "branch": "main",
                "provider": "GitHub",
                "repositoryToken": "[parameters('repositoryToken')]",
                "stagingEnvironmentPolicy": "Enabled",
                "allowConfigFileUpdates": true,
                "buildProperties": {
                  "appLocation": "/frontend",
                  "apiLocation": "/api",
                  "outputLocation": "dist",
                  "skipGithubActionWorkflowGeneration": true
                }
              }
            },
            {
              "type": "Microsoft.Web/staticSites/config",
              "apiVersion": "2023-12-01",
              "name": "[format('{0}/{1}', parameters('name'), 'appsettings')]",
              "properties": {
                "COSMOS_CONNECTION_STRING": "[format('@Microsoft.KeyVault(SecretUri={0})', parameters('cosmosSecretUri'))]",
                "COSMOS_DB_NAME": "[parameters('cosmosDbName')]",
                "ADMIN_KEY": "[format('@Microsoft.KeyVault(SecretUri={0})', parameters('adminSecretUri'))]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Web/staticSites', parameters('name'))]"
              ]
            }
          ],
          "outputs": {
            "defaultHostname": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('name')), '2023-12-01').defaultHostname]"
            },
            "principalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('name')), '2023-12-01', 'full').identity.principalId]"
            },
            "staticWebAppId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/staticSites', parameters('name'))]"
            }
          }
        }
      },
      "dependsOn": [
        "cosmos",
        "keyVault"
      ]
    },
    "keyVaultAccess": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "keyVaultAccessDeploy",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "vaultName": {
            "value": "[reference('keyVault').outputs.vaultName.value]"
          },
          "principalId": {
            "value": "[reference('staticWebApp').outputs.principalId.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.39.26.7824",
              "templateHash": "625191148611732024"
            }
          },
          "parameters": {
            "vaultName": {
              "type": "string",
              "metadata": {
                "description": "Key Vault name"
              }
            },
            "principalId": {
              "type": "string",
              "metadata": {
                "description": "Static Web App managed identity principal ID"
              }
            }
          },
          "variables": {
            "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.KeyVault/vaults/{0}', parameters('vaultName'))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('vaultName')), parameters('principalId'), variables('keyVaultSecretsUserRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "keyVault",
        "staticWebApp"
      ]
    }
  },
  "outputs": {
    "staticWebAppHostname": {
      "type": "string",
      "value": "[reference('staticWebApp').outputs.defaultHostname.value]"
    },
    "cosmosDbEndpoint": {
      "type": "string",
      "value": "[reference('cosmos').outputs.endpoint.value]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[reference('keyVault').outputs.vaultName.value]"
    }
  }
}