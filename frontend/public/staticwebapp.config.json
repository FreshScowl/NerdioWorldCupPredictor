{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "*.{css,scss,js,png,gif,ico,jpg,jpeg,svg,webp,woff,woff2,json,map,wasm}"
    ]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/admin",
      "rewrite": "/index.html"
    },
    {
      "route": "/predict",
      "rewrite": "/index.html"
    },
    {
      "route": "/leaderboard",
      "rewrite": "/index.html"
    }
  ]
}
